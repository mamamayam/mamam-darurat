+
+// ── 1. Pilih nama + PIN ─────────────────────────────────────────────
+function PinGate({ people, verifyPin, onUnlock }) {
+  const [picked, setPicked] = useState(null);
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [att, setAtt] = useState(null);
