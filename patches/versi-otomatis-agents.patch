diff --git a/.github/workflows/versioning.yml b/.github/workflows/versioning.yml
new file mode 100644
index 0000000..c765337
--- /dev/null
+++ b/.github/workflows/versioning.yml
@@ -0,0 +1,51 @@
+# Versi otomatis: tiap push ke main, naikkan versi di package.json sesuai awalan pesan commit
+# (feat -> minor, feat! / BREAKING CHANGE -> major, lainnya -> patch), lalu beri tag vX.Y.Z.
+# Aturan lengkap: docs/versioning.md. Jangan naikkan versi manual.
+name: Versi otomatis
+
+on:
+  push:
+    branches: [main]
+
+# Satu per satu, supaya dua push beruntun tidak saling menimpa nomor versi.
+concurrency:
+  group: versi-otomatis
+  cancel-in-progress: false
+
+permissions:
+  contents: write
+
+jobs:
+  bump:
+    # Commit rilis buatan Action ini tidak boleh memicu putaran baru.
+    if: ${{ !startsWith(github.event.head_commit.message, 'chore(release):') }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+          fetch-depth: 0
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Hitung versi baru
+        id: bump
+        env:
+          BEFORE: ${{ github.event.before }}
+          AFTER: ${{ github.sha }}
+        run: node scripts/bump-version.mjs --range "$BEFORE..$AFTER"
+
+      - name: Commit dan tag versi
+        if: steps.bump.outputs.bumped == 'true'
+        env:
+          VERSION: ${{ steps.bump.outputs.version }}
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add package.json package-lock.json
+          git commit -m "chore(release): v$VERSION"
+          git tag "v$VERSION"
+          git pull --rebase origin main
+          git push origin main --follow-tags
