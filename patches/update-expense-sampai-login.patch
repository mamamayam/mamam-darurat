+    expect(rows).toHaveLength(2350); expect(calls).toHaveLength(3);
+    expect(calls.map((c) => [c.a, c.b])).toEqual([[0, 999], [1000, 1999], [2000, 2999]]);
+  });
+  it('tepat kelipatan 1000 tidak berhenti terlalu awal', async () => {
