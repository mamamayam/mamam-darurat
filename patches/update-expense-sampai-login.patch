+      row({ id: 'm', employeeId: 'EMP-1', type: 'masuk', date: '2026-09-04T01:00:00Z', dateStr: '2026-09-04' }),
+    ]);
+    expect(r.logs.find((l) => l.type === 'libur').employeeId).toBe('uuid-2');
