+    await fetchAttendanceRows(client, '2026-09-01', '2026-09-30');
+    expect(calls[0]).toMatchObject({ table: 'attendanceLog', gte: ['payload->>dateStr', '2026-09-01'], lte: ['payload->>dateStr', '2026-09-30'] });
