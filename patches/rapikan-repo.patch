-  address                  text,
-  role                     text not null default 'kasir',   -- 'kasir' | 'kurir'
-  status                   text not null default 'aktif'
-                             check (status in ('aktif','freelance','cuti','resign')),
-  wage_per_hour            integer not null default 0,
