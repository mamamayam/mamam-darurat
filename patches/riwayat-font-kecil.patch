+@theme {
+  --text-xs: 0.6875rem;   --text-xs--line-height: 1rem;      /* 11px */
+  --text-sm: 0.8125rem;   --text-sm--line-height: 1.25rem;   /* 13px */
+  --text-base: 0.8125rem; --text-base--line-height: 1.25rem; /* 13px (sama dgn sm) */
+  --text-lg: 0.9375rem;   --text-lg--line-height: 1.375rem;  /* 15px */
+  --text-xl: 1.0625rem;   --text-xl--line-height: 1.5rem;    /* 17px */
+  --text-2xl: 1.1875rem;  --text-2xl--line-height: 1.625rem; /* 19px */
+  --text-3xl: 1.375rem;   --text-3xl--line-height: 1.75rem;  /* 22px */
+  --text-4xl: 1.625rem;   --text-4xl--line-height: 2rem;     /* 26px */
+}
 /* Custom variant "short:" — target layar dengan tinggi terbatas (khas HP
    landscape: lebar bisa >768px tapi tinggi cuma ~360-420px). Breakpoint
    bawaan Tailwind (md/lg) cuma baca lebar, jadi HP landscape sering kena
    treat kayak tablet/desktop dan sidebar/bottom-nav jadi permanen di layar
    yang sebenarnya sempit. "short:" mengisi celah itu. */
 @custom-variant short (@media (max-height: 480px) and (orientation: landscape));
+/* Ukuran dasar: elemen yang TIDAK punya class text-* (tombol, input, select,
+   teks polos) ikut 13px, bukan 16px bawaan browser. */
+@layer base {
+  body {
+    font-size: var(--text-sm);
+    line-height: var(--text-sm--line-height);
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+  }
+}
 /* App-shell: dokumen TIDAK boleh ikut scroll. Header & navbar nempel (flex di
