+                        <IconButton variant="edit" size="sm" onClick={() => handleEditOption(opt)}><Edit3 className="w-4 h-4" /></IconButton>
+                        <IconButton variant="delete" size="sm" onClick={() => handleRemoveOption(opt.id)}><Trash className="w-4 h-4" /></IconButton>
+                      </div>
