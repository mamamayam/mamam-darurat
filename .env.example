VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sumber absensi (project Supabase yang dipakai web absensi) — BACA-SAJA, untuk halaman Penggajian.
# URL tanpa /rest/v1/. Isi di .env.local, jangan ditempel di chat.
VITE_ABSENSI_SUPABASE_URL=
VITE_ABSENSI_SUPABASE_ANON_KEY=

# Login Supabase Auth (lihat docs/auth-setup.md). Kosongkan = mode lama (PIN lokal di src/auth/pins.js).
# Email owner: tujuan email "Lupa PIN". Akun staf otomatis memakai alias nama+staf@domain
# (Gmail menerimanya di kotak surat yang sama), atau isi VITE_AUTH_STAFF_EMAIL sendiri.
VITE_AUTH_OWNER_EMAIL=
VITE_AUTH_STAFF_EMAIL=
