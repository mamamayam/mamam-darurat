+    const idxBase = b.index;
+    b.userForward(); await tick(40);
+    expect(closed).toBe(1);
+    expect(bs.snapshot()).toMatchObject({ layers: 0, depth: 0, traversing: false });
+    expect(b.index).toBe(idxBase);                               // kembali di entri dasar
+  });
